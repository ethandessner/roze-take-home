{
  "name": "roze",
  "version": "0.1.0",
  "description": "Personal Memory System CLI: turns Gmail history into a queryable brain (people, projects, interests, open loops).",
  "type": "module",
  "bin": {
    "roze": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && shx chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "open": "^10.1.0",
    "openai": "^4.63.0",
    "ora": "^8.1.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.7.4",
    "shx": "^0.3.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
