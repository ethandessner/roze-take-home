# Google Cloud OAuth client credentials (Desktop app type recommended).
# Create these in Google Cloud Console -> APIs & Services -> Credentials.
# The OAuth consent screen must be in "Testing" mode with the
# https://www.googleapis.com/auth/gmail.readonly scope and agent@roze.ai
# added as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API key used to extract the brain and answer prompt queries.
OPENAI_API_KEY=
